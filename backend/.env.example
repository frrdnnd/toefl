# =====================================================
# SMARTTOEFL AI - Backend environment configuration
# Copy this file to ".env" and adjust the values.
# =====================================================

# Which LLM engine to use: openai | ollama | dataset
#   openai  -> OpenAI API (stable quality, needs OPENAI_API_KEY)
#   ollama  -> local Ollama model (free, offline)
#   dataset -> no LLM, always serve the local JSON question bank
LLM_PROVIDER=ollama

# ---- OpenAI (used when LLM_PROVIDER=openai) ----
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4o-mini
# Optional: custom/proxy base URL, leave empty for the default OpenAI endpoint
# OPENAI_BASE_URL=

# ---- Ollama (used when LLM_PROVIDER=ollama) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# ---- RAG (knowledge grounding from the dataset vector store) ----
# true  -> AI question generation & explanations are grounded with TOEFL material
# false -> skip RAG entirely
USE_RAG=true
RAG_TOP_K=3
